---
import PageShell from "../components/layout/PageShell.astro";
import ContactEmailSection from "../components/sections/contact/ContactEmailSection.astro";
import ContactHeroSection from "../components/sections/contact/ContactHeroSection.astro";
import ContactNextStepsSection from "../components/sections/contact/ContactNextStepsSection.astro";
import ContactPathsSection from "../components/sections/contact/ContactPathsSection.astro";
import ContactPurposeSection from "../components/sections/contact/ContactPurposeSection.astro";
import { contactPage } from "../content/pages/contact";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title={contactPage.title} description={contactPage.description}>
  <PageShell>
    <ContactHeroSection />
    <ContactPurposeSection />
    <ContactEmailSection />
    <ContactNextStepsSection />
    <ContactPathsSection />
  </PageShell>
</BaseLayout>
