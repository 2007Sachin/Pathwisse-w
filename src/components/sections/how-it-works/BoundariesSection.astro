---
import { boundaries } from "../../../content/pages/howItWorks";
---

<section class="boundaries section" aria-labelledby="boundaries-title">
  <div class="container boundaries__grid">
    <header>
      <p>Clear boundaries</p>
      <h2 id="boundaries-title">What Pathwisse does not promise.</h2>
      <p>
        A credible employability approach should be clear about what it cannot
        guarantee.
      </p>
    </header>
    <ul>
      {boundaries.map((boundary) => (
        <li>{boundary}</li>
      ))}
    </ul>
  </div>
</section>

<style>
  .boundaries__grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(3rem, 8vw, 8rem);
  }
  .boundaries header > p:first-child {
    color: var(--color-primary);
    font-size: var(--text-small);
    font-weight: var(--font-weight-semibold);
  }
  .boundaries header > p:last-child {
    color: var(--color-text-muted);
    font-size: var(--text-body-lg);
  }
  .boundaries ul {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-border-strong);
    list-style: none;
  }
  .boundaries li {
    padding: var(--space-6) 0;
    border-bottom: 1px solid var(--color-border);
    font-size: var(--text-body-lg);
  }
  @media (max-width: 48rem) {
    .boundaries__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
