---
import {
  approachStages,
  employabilityJourney,
} from "../../../content/pages/howItWorks";
import EmployabilityJourney from "../../visuals/EmployabilityJourney.astro";
---

<div class="stages" aria-label="Six stages in the Pathwisse approach">
  <div
    class="container stages__visual"
    data-scrub
    data-scrub-from="0.85"
    data-scrub-to="0.35"
  >
    <EmployabilityJourney stages={employabilityJourney} />
  </div>
  {approachStages.map((stage, index) => (
    <section
      id={stage.id}
      class:list={["stage section", { "stage--subtle": index % 2 === 1 }]}
      aria-labelledby={`${stage.id}-title`}
    >
      <div class="container stage__grid">
        <div class="stage__marker" aria-hidden="true">
          <span>{stage.number}</span>
          <i></i>
        </div>
        <header>
          <p>{stage.eyebrow}</p>
          <h2 id={`${stage.id}-title`}>{stage.title}</h2>
          <p>{stage.lead}</p>
        </header>
        <div class="stage__body">
          {stage.body.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
          <p class="stage__contrast">{stage.contrast}</p>
        </div>
      </div>
    </section>
  ))}
</div>

<style>
  .journey-visual {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    padding-block: var(--space-8);
  }
  .journey-visual__stage {
    position: relative;
    display: grid;
    gap: var(--space-2);
    padding-inline: var(--space-2);
    color: var(--color-ink);
  }
  .journey-visual__stage:not(:last-child)::after {
    position: absolute;
    top: 0.55rem;
    left: 50%;
    width: 100%;
    height: 1px;
    background: var(--color-primary);
    content: "";
    opacity: 0.45;
  }
  .journey-visual__stage span {
    position: relative;
    z-index: 1;
    display: grid;
    width: 1.2rem;
    height: 1.2rem;
    place-items: center;
    border: 1px solid var(--color-primary);
    border-radius: 50%;
    background: var(--color-bg);
    color: var(--color-primary);
    font-size: 0.6rem;
  }
  .journey-visual__stage strong {
    font-size: var(--text-small);
    font-weight: var(--font-weight-semibold);
  }
  .stage--subtle {
    background: var(--color-surface-subtle);
  }
  .stage__grid {
    display: grid;
    grid-template-columns: 0.2fr 0.8fr 1fr;
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }
  .stage__marker {
    display: grid;
    justify-items: center;
    gap: var(--space-4);
    min-height: 12rem;
    color: var(--color-primary);
    font-size: var(--text-small);
  }
  .stage__marker span {
    display: grid;
    width: 2.5rem;
    height: 2.5rem;
    place-items: center;
    border: 2px solid currentColor;
    border-radius: 50%;
  }
  .stage__marker i {
    width: 1px;
    height: 100%;
    background: var(--color-primary);
    opacity: 0.4;
  }
  .stage header > p:first-child {
    color: var(--color-primary);
    font-size: var(--text-small);
    font-weight: var(--font-weight-semibold);
  }
  .stage header > p:last-child {
    color: var(--color-text-muted);
    font-size: var(--text-body-lg);
  }
  .stage__body {
    max-width: 40rem;
    color: var(--color-text-muted);
  }
  .stage__contrast {
    margin-top: var(--space-10);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border-strong);
    color: var(--color-ink);
    font-weight: var(--font-weight-medium);
  }
  @media (max-width: 48rem) {
    .journey-visual {
      grid-template-columns: 1fr;
      gap: var(--space-3);
      padding-block: var(--space-6);
    }
    .journey-visual__stage {
      grid-template-columns: 1.2rem 1fr;
      align-items: center;
    }
    .journey-visual__stage:not(:last-child)::after {
      top: 1.2rem;
      left: 0.6rem;
      width: 1px;
      height: calc(100% + var(--space-3));
    }
    .stage__grid {
      grid-template-columns: 3rem 1fr;
      gap: var(--space-6);
    }
    .stage__body {
      grid-column: 2;
    }
  }
</style>
