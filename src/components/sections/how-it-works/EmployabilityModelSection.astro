---
import CinematicMedia from "../../media/CinematicMedia.astro";
import JourneyPath from "../../media/JourneyPath.astro";
import { employabilityJourney } from "../../../content/pages/howItWorks";
---

<section
  id="employability-model"
  class="model section section--dark"
  aria-labelledby="model-title"
>
  <div class="container">
    <header class="model__header">
      <p>The employability model</p>
      <div>
        <h2 id="model-title">One journey. Six connected ideas.</h2>
        <p>
          The journey Pathwisse is being built around—a strategic model, not
          verified software modules.
        </p>
      </div>
    </header>
    <div class="model__path">
      <CinematicMedia src="/media/motion/how-it-works/employability-journey" />
      <JourneyPath
        stages={employabilityJourney}
        dark
        compact
        label="Direction, development, application, demonstration, preparation, and opportunity"
      />
    </div>
  </div>
</section>

<style>
  .model__header {
    display: grid;
    gap: var(--space-4);
  }
  .model__header > p,
  .model__header div > p {
    color: var(--color-text-muted-on-dark);
  }
  .model__header > p {
    font-size: var(--text-small);
  }
  .model__header div > p {
    max-width: var(--width-reading);
    font-size: var(--text-body-lg);
  }
  .model__header > p {
    margin: 0;
  }
  .model__path > :global(.cinematic) {
    width: min(100%, 56rem);
  }
  .model__path {
    display: grid;
    gap: var(--space-8);
    margin-top: var(--space-12);
  }
</style>
