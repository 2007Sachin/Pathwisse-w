---
import { productLinks } from "../../../content/site";
---

<section
  id="final-cta"
  class="final-cta section section--dark"
  aria-labelledby="final-cta-title"
>
  <div class="container">
    <h2 id="final-cta-title">Choose the next conversation.</h2>
    <div class="final-cta__paths">
      <div>
        <p>For students</p>
        <h3>Start building what comes after learning.</h3>
        <a class="button button--primary" href={productLinks.getStarted}>
          Start Your Journey
        </a>
      </div>
      <div>
        <p>For institutions</p>
        <h3>Build employability into the student journey.</h3>
        <a class="button button--secondary" href="/contact">
          Request a Demo
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .final-cta {
    background:
      radial-gradient(
        50rem 26rem at 12% 0%,
        rgb(23 92 211 / 0.38),
        transparent 70%
      ),
      radial-gradient(
        38rem 20rem at 100% 100%,
        rgb(200 104 35 / 0.14),
        transparent 70%
      ),
      var(--color-ink-deep);
  }
  .final-cta h2 {
    margin-bottom: var(--space-12);
    font-size: var(--text-h3);
  }
  .final-cta__paths {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-top: 1px solid rgb(255 255 255 / 0.22);
  }
  .final-cta__paths > div {
    display: flex;
    min-height: 22rem;
    flex-direction: column;
    align-items: flex-start;
    padding: var(--space-8) var(--space-8) 0 0;
  }
  .final-cta__paths > div + div {
    padding-left: var(--space-8);
    border-left: 1px solid rgb(255 255 255 / 0.22);
  }
  .final-cta__paths p {
    color: var(--color-text-muted-on-dark);
    font-size: var(--text-small);
  }
  .final-cta__paths h3 {
    max-width: 16ch;
    margin-block: var(--space-8) auto;
    color: var(--color-text-on-dark);
    font-size: var(--text-h2);
  }
  .final-cta .button--secondary {
    border-color: rgb(255 255 255 / 0.5);
    background: transparent;
    color: var(--color-text-on-dark);
  }
  .final-cta .button--secondary:hover {
    border-color: var(--color-text-on-dark);
    background: rgb(255 255 255 / 0.08);
  }
  @media (max-width: 44rem) {
    .final-cta__paths {
      grid-template-columns: 1fr;
    }
    .final-cta__paths > div {
      min-height: 18rem;
      padding-right: 0;
    }
    .final-cta__paths > div + div {
      padding-left: 0;
      border-top: 1px solid rgb(255 255 255 / 0.22);
      border-left: 0;
    }
  }
</style>
