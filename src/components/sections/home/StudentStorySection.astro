---
import { studentJourney } from "../../../content/pages/home";
import CinematicMedia from "../../media/CinematicMedia.astro";
---

<section
  id="student-story"
  class="story section section--subtle"
  aria-labelledby="story-title"
  data-stages="line"
>
  <div class="container story__grid">
    <div class="story__left">
      <div class="story__intro">
        <p class="story__label">Illustrative student journey</p>
        <h2 id="story-title">
          Aanya has ambition. What she needs is a direction.
        </h2>
        <p>
          Aanya wants a technology career but doesn’t know which role fits. This
          fictional story shows the journey Pathwisse is working toward—not a
          product walkthrough or a real student result.
        </p>
      </div>

      <div class="story__scene">
        <CinematicMedia
          src="/media/motion/students/skill-to-story"
          tone="light"
        />
      </div>
    </div>

    <ol class="story__steps">
      {studentJourney.map((step, index) => (
        <li data-stage>
          <span>{String(index + 1).padStart(2, "0")}</span>
          {step}
        </li>
      ))}
    </ol>

    <div class="story__close">
      <p>Not a promised result—work and decisions Aanya can explain.</p>
      <a class="button button--secondary" href="/students">
        Explore Pathwisse for Students
      </a>
    </div>
  </div>
</section>

<style>
  .story__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(18rem, 0.95fr);
    gap: var(--space-12) clamp(3rem, 7vw, 7rem);
  }
  .story__left {
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
  }
  .story__label {
    color: var(--color-primary);
    font-size: var(--text-caption);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }
  .story__intro h2 {
    margin-block: var(--space-6);
  }
  .story__intro > p:last-child {
    color: var(--color-text-muted);
    font-size: var(--text-body-lg);
  }
  .story__scene {
    width: 100%;
  }
  .story__scene :global(.cinematic) {
    box-shadow: var(--shadow-subtle);
  }

  .story__steps {
    position: relative;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .story__steps::before {
    position: absolute;
    top: 1.65rem;
    bottom: 1.65rem;
    left: 1rem;
    width: 1px;
    background: linear-gradient(var(--color-primary), var(--color-accent));
    content: "";
  }
  .story__steps li {
    position: relative;
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: var(--space-5);
    align-items: center;
    padding-block: var(--space-5);
    border-bottom: var(--border-width) solid var(--color-border);
    font-weight: var(--font-weight-medium);
    transition:
      color var(--motion-standard) var(--ease-standard),
      opacity var(--motion-standard) var(--ease-standard);
  }
  .story__steps li > span {
    position: relative;
    z-index: 1;
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border: 1px solid var(--color-primary);
    border-radius: 50%;
    background: var(--color-surface-subtle);
    color: var(--color-text-muted);
    font-size: var(--text-caption);
    transition:
      background-color var(--motion-standard) var(--ease-standard),
      color var(--motion-standard) var(--ease-standard);
  }
  .story__close {
    display: flex;
    flex-wrap: wrap;
    grid-column: 1 / -1;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5) var(--space-8);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
  }
  .story__close p {
    max-width: 34rem;
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-body-lg);
  }

  @media (min-width: 56rem) {
    .story__left {
      align-self: stretch;
    }
    .story__scene {
      align-self: start;
    }
    :global(.motion-enhanced) .story__steps li {
      min-height: 14vh;
    }
    :global(.motion-enhanced) .story__steps li:last-child {
      min-height: 12vh;
    }
  }
  :global(.motion-enhanced) .story__steps li:not(.is-active):not(.is-past) {
    color: var(--color-text-muted);
  }
  :global(.motion-enhanced) .story__steps li.is-active {
    color: var(--color-ink);
  }
  :global(.motion-enhanced) .story__steps li.is-active > span,
  :global(.motion-enhanced) .story__steps li.is-past > span {
    background: var(--color-primary);
    color: var(--color-primary-contrast);
  }
  :global(.motion-enhanced) .story__steps li:last-child.is-active > span {
    border-color: var(--color-accent);
    background: var(--color-accent);
  }
  @media (max-width: 55.99rem) {
    .story__grid {
      grid-template-columns: 1fr;
    }
    .story__close {
      grid-column: auto;
    }
    .story__left {
      display: contents;
    }
    .story__scene {
      width: 100%;
    }
  }
</style>
