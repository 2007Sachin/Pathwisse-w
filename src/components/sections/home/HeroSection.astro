---
import { productLinks } from "../../../content/site";
import CinematicMedia from "../../media/CinematicMedia.astro";
---

<section
  id="hero"
  class="hero section"
  aria-labelledby="hero-title"
  data-scrub="leave"
>
  <div class="container-wide hero__grid">
    <div class="hero__content">
      <p class="eyebrow">Employability for higher education</p>
      <h1 id="hero-title">
        Learning gives you knowledge.{" "}
        <span>Employability asks what comes next.</span>
      </h1>
      <p class="hero__lead">
        Pathwisse is being built to connect career direction, development,
        application, and placement preparation.
      </p>
      <div class="hero__actions cluster">
        <a class="button button--primary" href={productLinks.getStarted}>
          Start Your Journey
        </a>
        <a class="button button--secondary" href="/how-it-works">
          See How Pathwisse Works
        </a>
      </div>
      <a class="action-link hero__institution-link" href="/institutions">
        For colleges and universities
      </a>
    </div>

    <div class="hero__stage">
      <CinematicMedia
        src="/media/motion/home/pathwisse-hero-journey"
        ratio="6 / 7"
        priority="high"
        mobile="play"
      />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: clip;
    padding-block: clamp(3rem, 7vw, 6rem) var(--section-spacious);
    background:
      radial-gradient(
        60rem 40rem at 88% 12%,
        rgb(23 92 211 / 0.09),
        transparent 70%
      ),
      var(--color-bg);
  }
  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    align-items: center;
    gap: clamp(2.5rem, 5vw, 5rem);
  }
  .eyebrow {
    margin-bottom: var(--space-8);
    color: var(--color-primary);
    font-size: var(--text-caption);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  h1 {
    max-width: 15ch;
    margin-bottom: var(--space-8);
    font-size: clamp(2.75rem, 4.2vw, 4.75rem);
  }
  h1 span {
    color: var(--color-primary);
  }
  .hero__lead {
    max-width: 38rem;
    margin-bottom: var(--space-8);
    color: var(--color-text-muted);
    font-size: var(--text-body-lg);
  }
  .hero__actions {
    margin-bottom: var(--space-6);
  }
  .hero__institution-link {
    font-size: var(--text-small);
  }

  .hero__stage {
    position: relative;
    width: 100%;
    max-width: 40rem;
    justify-self: end;
  }
  .hero__stage::before {
    position: absolute;
    z-index: -1;
    inset: -12%;
    background: radial-gradient(
      closest-side,
      rgb(23 92 211 / 0.32),
      transparent 72%
    );
    content: "";
  }
  .hero__stage :global(.cinematic) {
    box-shadow: 0 2.5rem 6rem rgb(8 23 45 / 0.28);
  }

  @media (max-width: 52rem) {
    .hero__grid {
      grid-template-columns: 1fr;
      align-items: start;
    }
    .hero__stage {
      max-width: 34rem;
      justify-self: start;
    }
  }
  @media (max-width: 34rem) {
    .hero__actions {
      align-items: stretch;
      flex-direction: column;
    }
    .hero__actions .button {
      width: 100%;
    }
  }
</style>
