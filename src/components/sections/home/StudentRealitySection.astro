---
import { learningMoments } from "../../../content/pages/home";
---

<section
  id="student-reality"
  class="reality section section--subtle"
  aria-labelledby="reality-title"
>
  <div
    class="container reality__grid"
    data-scrub
    data-scrub-from="0.85"
    data-scrub-to="0.35"
  >
    <div class="reality__intro">
      <p class="section-number">Student reality</p>
      <h2 id="reality-title">
        You have done the work. But does it tell one clear story?
      </h2>
      <p>
        Courses, certificates, workshops, and projects all matter. The difficult
        part is understanding how they connect—and explaining what they have
        helped you learn to do.
      </p>
    </div>
    <ol
      class="reality__timeline"
      aria-label="A familiar student learning timeline"
    >
      {learningMoments.map((moment, index) => (
        <li style={`--i: ${index}`}>
          <span>{String(index + 1).padStart(2, "0")}</span>
          <strong>{moment}</strong>
        </li>
      ))}
    </ol>
    <p class="reality__question">What can you actually do?</p>
  </div>
</section>

<style>
  .reality__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(20rem, 1.2fr);
    gap: var(--space-16);
  }
  .section-number {
    color: var(--color-primary);
    font-size: var(--text-caption);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .reality__intro h2 {
    margin-block: var(--space-6);
  }
  .reality__intro > p:last-child {
    color: var(--color-text-muted);
    font-size: var(--text-body-lg);
  }
  .reality__timeline {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .reality__timeline li {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: var(--space-5);
    padding-block: var(--space-5);
    border-bottom: var(--border-width) solid var(--color-border);
  }
  .reality__timeline span {
    color: var(--color-text-muted);
    font-size: var(--text-small);
  }
  .reality__timeline strong {
    font-size: var(--text-h3);
    font-weight: var(--font-weight-medium);
  }
  .reality__question {
    grid-column: 1 / -1;
    max-width: 12ch;
    margin: var(--space-12) 0 0 auto;
    color: var(--color-ink);
    font-size: var(--text-statement);
    font-weight: var(--font-weight-medium);
    letter-spacing: -0.04em;
    line-height: 1;
  }
  :global(.motion-enhanced) .reality__timeline li {
    --k: clamp(0, calc(var(--p, 1) * 5.5 - var(--i) * 0.9), 1);
    opacity: calc(0.5 + var(--k) * 0.5);
    translate: calc((1 - var(--k)) * 1rem) 0;
  }
  :global(.motion-enhanced) .reality__timeline li > span {
    color: color-mix(
      in srgb,
      var(--color-primary) calc(var(--k) * 100%),
      var(--color-text-muted)
    );
  }
  :global(.motion-enhanced) .reality__question {
    opacity: clamp(0.4, calc((var(--p, 1) - 0.7) * 4), 1);
  }
  @media (max-width: 48rem) {
    .reality__grid {
      grid-template-columns: 1fr;
      gap: var(--space-10);
    }
    .reality__question {
      grid-column: auto;
      margin: var(--space-6) 0 0;
    }
  }
</style>
