---
import {
  programBoundaries,
  programEvaluationPrinciples,
} from "../../../content/pages/programs";
---

<section
  class="program-principles section section--subtle"
  aria-labelledby="program-principles-title"
>
  <div class="container program-principles__grid">
    <header>
      <p>How programs will be evaluated</p>
      <h2 id="program-principles-title">
        Publish the purpose, scope, and limits together.
      </h2>
    </header>
    <ol>
      {programEvaluationPrinciples.map((principle, index) => (
        <li>
          <span>{String(index + 1).padStart(2, "0")}</span>
          {principle}
        </li>
      ))}
    </ol>
  </div>
</section>
<section
  class="program-boundaries section"
  aria-labelledby="program-boundaries-title"
>
  <div class="container program-principles__grid">
    <header>
      <p>What Pathwisse will not claim</p>
      <h2 id="program-boundaries-title">
        Completion is not an employment promise.
      </h2>
    </header>
    <ul>
      {programBoundaries.map((boundary) => (
        <li>{boundary}</li>
      ))}
    </ul>
  </div>
</section>

<style>
  .program-principles__grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(3rem, 9vw, 9rem);
  }
  .program-principles__grid header p {
    color: var(--color-primary);
    font-size: var(--text-small);
    font-weight: var(--font-weight-semibold);
  }
  .program-principles ol,
  .program-boundaries ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .program-principles li {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: var(--space-5);
    padding-block: var(--space-5);
    border-top: 1px solid var(--color-border);
    font-weight: var(--font-weight-medium);
  }
  .program-principles li span {
    color: var(--color-primary);
    font-size: var(--text-small);
  }
  .program-boundaries li {
    padding-block: var(--space-5);
    border-top: 1px solid var(--color-border);
    color: var(--color-text-muted);
  }
  @media (max-width: 48rem) {
    .program-principles__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
