---
import { institutionFaqs } from "../../../content/pages/institutions";
---

<section
  class="institution-faq section"
  aria-labelledby="institution-faq-title"
>
  <div class="container institution-faq__grid">
    <header>
      <p>Institution questions</p>
      <h2 id="institution-faq-title">
        A clear evaluation starts with honest boundaries.
      </h2>
    </header>
    <div>
      {institutionFaqs.map((item) => (
        <details>
          <summary>{item.question}</summary>
          <p>{item.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .institution-faq__grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(3rem, 9vw, 9rem);
  }
  .institution-faq header p {
    color: var(--color-primary);
    font-size: var(--text-small);
    font-weight: var(--font-weight-semibold);
  }
  .institution-faq details {
    border-top: 1px solid var(--color-border-strong);
  }
  .institution-faq details:last-child {
    border-bottom: 1px solid var(--color-border-strong);
  }
  .institution-faq summary {
    min-height: 3rem;
    padding: var(--space-6) var(--space-10) var(--space-6) 0;
    color: var(--color-ink);
    font-size: var(--text-body-lg);
    font-weight: var(--font-weight-medium);
    cursor: pointer;
  }
  .institution-faq details p {
    max-width: 42rem;
    padding: 0 var(--space-10) var(--space-6) 0;
    color: var(--color-text-muted);
  }
  @media (max-width: 48rem) {
    .institution-faq__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
