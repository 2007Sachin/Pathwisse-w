---
import { institutionActivities } from "../../../content/pages/institutions";
import CinematicMedia from "../../media/CinematicMedia.astro";
---

<section
  class="fragmented section section--subtle"
  aria-labelledby="fragmented-title"
>
  <div class="container fragmented__grid">
    <header>
      <p>Fragmented employability activity</p>
      <h2 id="fragmented-title">Useful work can happen in separate places.</h2>
      <p>
        The issue isn’t a lack of effort. Useful experiences happen at different
        times, for different purposes—before students need to explain the full
        story.
      </p>
      <ul aria-label="Separate institutional employability activities">
        {institutionActivities.map((activity) => (
          <li>{activity}</li>
        ))}
      </ul>
    </header>
    <CinematicMedia
      src="/media/motion/institutions/institution-fragments-to-journey"
      tone="light"
    />
  </div>
</section>

<style>
  .fragmented__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    align-items: center;
    gap: clamp(2.5rem, 6vw, 6rem);
  }
  .fragmented header > p:first-child {
    color: var(--color-primary);
    font-size: var(--text-small);
    font-weight: var(--font-weight-semibold);
  }
  .fragmented header > p:nth-of-type(2) {
    color: var(--color-text-muted);
    font-size: var(--text-body-lg);
  }
  .fragmented ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-6) 0 0;
    padding: 0;
    list-style: none;
  }
  .fragmented li {
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-surface);
    color: var(--color-text);
    font-size: var(--text-small);
  }
  @media (max-width: 48rem) {
    .fragmented__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
