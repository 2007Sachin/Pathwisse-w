---
import { studentPrinciples } from "../../../content/pages/students";
import DrawnPath from "../../motion/DrawnPath.astro";
const content = studentPrinciples.demonstration;
---

<section
  class="demonstration section section--subtle"
  aria-labelledby="demonstration-title"
  data-scrub
  data-scrub-from="0.8"
  data-scrub-to="0.35"
>
  <div class="container demonstration__grid">
    <header>
      <p>{content.eyebrow}</p>
      <h2 id="demonstration-title">{content.title}</h2>
      <p>{content.lead}</p>
    </header>
    <div
      class="demonstration__shift"
      aria-label="From a skill label to a grounded example"
    >
      <p>
        <span>From</span>
        {content.before}
      </p>
      <DrawnPath />
      <p>
        <span>Toward</span>
        {content.after}
      </p>
    </div>
  </div>
</section>

<style>
  .demonstration__grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(3rem, 9vw, 9rem);
  }
  .demonstration header > p:first-child {
    color: var(--color-primary);
    font-size: var(--text-small);
    font-weight: var(--font-weight-semibold);
  }
  .demonstration header > p:last-child {
    color: var(--color-text-muted);
    font-size: var(--text-body-lg);
  }
  .demonstration__shift {
    display: grid;
    align-content: center;
    gap: var(--space-5);
    position: relative;
  }
  .demonstration__shift p {
    margin: 0;
    padding-block: var(--space-6);
    border-block: 1px solid var(--color-border);
    font-size: var(--text-h3);
    transition:
      opacity var(--motion-story) var(--ease-standard),
      transform var(--motion-story) var(--ease-emphasis);
  }
  .demonstration__shift p:first-child {
    opacity: clamp(0.62, calc(1 - var(--p, 0) * 0.35), 1);
  }
  .demonstration__shift p:last-child {
    opacity: clamp(0.55, calc(0.55 + var(--p, 0) * 0.45), 1);
    transform: translateY(calc((1 - var(--p, 0)) * 0.75rem));
  }
  .demonstration__shift span {
    display: block;
    margin-bottom: var(--space-3);
    color: var(--color-text-muted);
    font-size: var(--text-caption);
    text-transform: uppercase;
  }
  .demonstration__shift .drawn-path {
    width: 1px;
    height: 2.5rem;
    margin-left: var(--space-4);
  }
  @media (prefers-reduced-motion: reduce) {
    .demonstration__shift p {
      opacity: 1 !important;
      transform: none !important;
    }
  }
  @media (max-width: 48rem) {
    .demonstration__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
