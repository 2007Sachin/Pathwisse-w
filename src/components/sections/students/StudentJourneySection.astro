---
import { aanyaJourney } from "../../../content/pages/students";
---

<section
  class="student-journey section"
  aria-labelledby="student-journey-title"
>
  <div class="container">
    <header class="student-journey__header">
      <div>
        <p>Illustrative student journey</p>
        <h2 id="student-journey-title">
          Aanya begins with uncertainty, not a finished plan.
        </h2>
      </div>
      <p>
        Aanya is an illustrative student journey. She helps show how the
        employability ideas can connect across a student's decisions and work.
      </p>
    </header>
    <ol class="student-journey__steps" data-motion="sequence">
      {aanyaJourney.map((step, index) => (
        <li data-motion-item style={`--motion-index: ${index}`}>
          <span>{String(index + 1).padStart(2, "0")}</span>
          <strong>{step}</strong>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .student-journey__header {
    display: grid;
    grid-template-columns: 1fr 0.7fr;
    gap: clamp(3rem, 8vw, 8rem);
    align-items: end;
    margin-bottom: var(--space-20);
  }
  .student-journey__header div > p {
    color: var(--color-primary);
    font-size: var(--text-caption);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .student-journey__header > p {
    color: var(--color-text-muted);
    font-size: var(--text-body-lg);
  }
  .student-journey__steps {
    position: relative;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .student-journey__steps::before {
    position: absolute;
    top: 0.55rem;
    right: 0.5rem;
    left: 0.5rem;
    height: 1px;
    background: linear-gradient(
      90deg,
      var(--color-primary) 0 85%,
      var(--color-accent)
    );
    content: "";
  }
  .student-journey__steps li {
    position: relative;
    display: grid;
    gap: var(--space-3);
    padding: var(--space-8) var(--space-4) 0 0;
  }
  .student-journey__steps li::before {
    position: absolute;
    top: 0;
    width: 1.1rem;
    height: 1.1rem;
    border: 3px solid var(--color-primary);
    border-radius: 50%;
    background: var(--color-bg);
    content: "";
  }
  .student-journey__steps li:last-child::before {
    border-color: var(--color-accent);
  }
  .student-journey__steps span {
    color: var(--color-text-muted);
    font-size: var(--text-caption);
  }
  .student-journey__steps strong {
    max-width: 12ch;
    font-size: var(--text-small);
  }
  @media (max-width: 48rem) {
    .student-journey__header {
      grid-template-columns: 1fr;
      margin-bottom: var(--space-12);
    }
    .student-journey__steps {
      grid-template-columns: 1fr;
      gap: 0;
      padding-left: var(--space-8);
    }
    .student-journey__steps::before {
      top: 0.5rem;
      bottom: 0.5rem;
      left: 0.5rem;
      width: 1px;
      height: auto;
      background: linear-gradient(
        180deg,
        var(--color-primary) 0 85%,
        var(--color-accent)
      );
    }
    .student-journey__steps li {
      min-height: 5rem;
      padding: 0 0 var(--space-6);
    }
    .student-journey__steps li::before {
      left: calc(-1 * var(--space-8));
    }
    .student-journey__steps strong {
      max-width: none;
    }
  }
</style>
