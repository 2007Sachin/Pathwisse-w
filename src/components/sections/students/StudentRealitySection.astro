---
import { studentWork } from "../../../content/pages/students";
import CinematicMedia from "../../media/CinematicMedia.astro";
---

<section
  class="student-reality section section--subtle"
  aria-labelledby="student-reality-title"
>
  <div class="container student-reality__grid">
    <header>
      <p>You’ve been doing the work</p>
      <h2 id="student-reality-title">
        The effort is real. The connection may not be.
      </h2>
      <p>
        Completing something tells you it ended—not always what should follow or
        how it adds up.
      </p>
      <ul aria-label="Familiar student experiences">
        {studentWork.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </header>
    <CinematicMedia
      src="/media/motion/students/student-fragments-to-path"
      tone="light"
    />
  </div>
</section>

<style>
  .student-reality__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    align-items: center;
    gap: clamp(2.5rem, 6vw, 6rem);
  }
  .student-reality header > p:first-child {
    color: var(--color-primary);
    font-size: var(--text-small);
    font-weight: var(--font-weight-semibold);
  }
  .student-reality header > p:nth-of-type(2) {
    color: var(--color-text-muted);
    font-size: var(--text-body-lg);
  }
  .student-reality ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-6) 0 0;
    padding: 0;
    list-style: none;
  }
  .student-reality li {
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-surface);
    color: var(--color-text);
    font-size: var(--text-small);
  }
  @media (max-width: 48rem) {
    .student-reality__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
