---
import { studentQuestions } from "../../../content/pages/students";
---

<section
  class="questions section section--dark"
  aria-labelledby="student-questions-title"
>
  <div class="container questions__grid">
    <header>
      <p>Why it can feel disconnected</p>
      <h2 id="student-questions-title">
        The questions arrive between the milestones.
      </h2>
      <p>
        Completion can tell you that something ended. It does not always tell
        you what should follow.
      </p>
    </header>
    <ul>
      {studentQuestions.map((question) => (
        <li>{question}</li>
      ))}
    </ul>
  </div>
</section>

<style>
  .questions__grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(3rem, 9vw, 9rem);
  }
  .questions header > p:first-child {
    color: #79a8ff;
    font-size: var(--text-small);
    font-weight: var(--font-weight-semibold);
  }
  .questions header > p:last-child {
    color: var(--color-text-muted-on-dark);
    font-size: var(--text-body-lg);
  }
  .questions ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .questions li {
    padding-block: var(--space-6);
    border-top: 1px solid rgb(255 255 255 / 0.2);
    color: var(--color-text-on-dark);
    font-size: var(--text-body-lg);
  }
  @media (max-width: 48rem) {
    .questions__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
