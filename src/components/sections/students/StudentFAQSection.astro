---
import { studentFaqs } from "../../../content/pages/students";
---

<section
  class="student-faq section section--subtle"
  aria-labelledby="student-faq-title"
>
  <div class="container student-faq__grid">
    <header>
      <p>Questions students may have</p>
      <h2 id="student-faq-title">
        Clear answers, without promises we cannot make.
      </h2>
    </header>
    <div>
      {studentFaqs.map((item) => (
        <details>
          <summary>{item.question}</summary>
          <p>{item.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .student-faq__grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(3rem, 9vw, 9rem);
  }
  .student-faq header p {
    color: var(--color-primary);
    font-size: var(--text-small);
    font-weight: var(--font-weight-semibold);
  }
  .student-faq details {
    border-top: 1px solid var(--color-border-strong);
  }
  .student-faq details:last-child {
    border-bottom: 1px solid var(--color-border-strong);
  }
  .student-faq summary {
    min-height: 3rem;
    padding: var(--space-6) var(--space-10) var(--space-6) 0;
    color: var(--color-ink);
    font-size: var(--text-body-lg);
    font-weight: var(--font-weight-medium);
    cursor: pointer;
  }
  .student-faq details p {
    max-width: 42rem;
    padding: 0 var(--space-10) var(--space-6) 0;
    color: var(--color-text-muted);
  }
  @media (max-width: 48rem) {
    .student-faq__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
