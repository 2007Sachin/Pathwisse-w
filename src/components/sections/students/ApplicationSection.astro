---
import { studentPrinciples } from "../../../content/pages/students";
const content = studentPrinciples.application;
---

<section class="application section" aria-labelledby="application-title">
  <div class="container application__grid">
    <div class="application__marker" aria-hidden="true">
      <span></span>
      <i></i>
      <span></span>
    </div>
    <header>
      <p>{content.eyebrow}</p>
      <h2 id="application-title">{content.title}</h2>
      <p>{content.lead}</p>
    </header>
    <p class="application__note">{content.note}</p>
  </div>
</section>

<style>
  .application__grid {
    display: grid;
    grid-template-columns: 5rem 1fr 0.8fr;
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }
  .application__marker {
    display: grid;
    justify-items: center;
    gap: var(--space-3);
    min-height: 13rem;
  }
  .application__marker span {
    width: 1rem;
    height: 1rem;
    border: 2px solid var(--color-primary);
    border-radius: 50%;
  }
  .application__marker i {
    width: 1px;
    height: 100%;
    background: var(--color-primary);
  }
  .application header > p:first-child {
    color: var(--color-primary);
    font-size: var(--text-small);
    font-weight: var(--font-weight-semibold);
  }
  .application header > p:last-child {
    color: var(--color-text-muted);
    font-size: var(--text-body-lg);
  }
  .application__note {
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border-strong);
    color: var(--color-text-muted);
  }
  @media (max-width: 48rem) {
    .application__grid {
      grid-template-columns: 2rem 1fr;
      gap: var(--space-5);
    }
    .application__note {
      grid-column: 2;
    }
  }
</style>
