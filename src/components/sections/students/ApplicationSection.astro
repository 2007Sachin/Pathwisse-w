---
import { studentPrinciples } from "../../../content/pages/students";
import DrawnPath from "../../motion/DrawnPath.astro";
const content = studentPrinciples.application;
---

<section
  class="application section"
  aria-labelledby="application-title"
  data-scrub
  data-scrub-from="0.85"
  data-scrub-to="0.35"
>
  <div class="container application__grid">
    <div class="application__marker" aria-hidden="true">
      <span class="application__node"></span>
      <DrawnPath />
      <span class="application__node application__node--end"></span>
    </div>
    <header>
      <p>{content.eyebrow}</p>
      <h2 id="application-title">{content.title}</h2>
      <p>{content.lead}</p>
    </header>
    <p class="application__note">{content.note}</p>
  </div>
</section>

<style>
  .application__grid {
    display: grid;
    grid-template-columns: 5rem 1fr 0.8fr;
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }
  .application__marker {
    display: grid;
    justify-items: center;
    gap: var(--space-3);
    min-height: 13rem;
  }
  .application__node {
    width: 1rem;
    height: 1rem;
    border: 2px solid var(--color-primary);
    border-radius: 50%;
  }
  .application__node--end {
    border-color: var(--color-accent);
    transform: scale(calc(1 + (var(--p, 0) * 0.12)));
  }
  .application header > p:first-child {
    color: var(--color-primary);
    font-size: var(--text-small);
    font-weight: var(--font-weight-semibold);
  }
  .application header > p:last-child {
    color: var(--color-text-muted);
    font-size: var(--text-body-lg);
  }
  .application__note {
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border-strong);
    color: var(--color-text-muted);
    opacity: clamp(0.55, calc(0.55 + var(--p, 0) * 0.45), 1);
    transform: translateX(calc((1 - var(--p, 0)) * 0.5rem));
    transition:
      opacity var(--motion-story) var(--ease-standard),
      transform var(--motion-story) var(--ease-emphasis);
  }
  @media (prefers-reduced-motion: reduce) {
    .application__note {
      opacity: 1;
      transform: none;
    }
    .application__node--end {
      transform: none;
    }
  }
  @media (max-width: 48rem) {
    .application__grid {
      grid-template-columns: 2rem 1fr;
      gap: var(--space-5);
    }
    .application__note {
      grid-column: 2;
    }
  }
</style>
