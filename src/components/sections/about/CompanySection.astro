---
import { companyFacts } from "../../../content/pages/about";
---

<section
  class="about-company section section--subtle"
  aria-labelledby="about-company-title"
>
  <div class="container about-company__grid">
    <header>
      <p>Who is building Pathwisse</p>
      <h2 id="about-company-title">
        Built by Shaquantum Labs Private Limited.
      </h2>
      <p>
        Pathwisse is the product and public employability direction being
        developed by Shaquantum Labs Private Limited.
      </p>
    </header>
    <dl>
      {companyFacts.map((fact) => (
        <div>
          <dt>{fact.label}</dt>
          <dd>{fact.value}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .about-company__grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(3rem, 9vw, 9rem);
  }
  .about-company header > p:first-child {
    color: var(--color-primary);
    font-size: var(--text-small);
    font-weight: var(--font-weight-semibold);
  }
  .about-company header > p:last-child {
    color: var(--color-text-muted);
    font-size: var(--text-body-lg);
  }
  .about-company dl {
    margin: 0;
    border-top: 1px solid var(--color-border-strong);
  }
  .about-company dl div {
    display: grid;
    grid-template-columns: 0.35fr 0.65fr;
    gap: var(--space-5);
    padding-block: var(--space-6);
    border-bottom: 1px solid var(--color-border);
  }
  .about-company dt {
    color: var(--color-primary);
    font-size: var(--text-small);
    font-weight: var(--font-weight-semibold);
  }
  .about-company dd {
    margin: 0;
    color: var(--color-ink);
    font-size: var(--text-body-lg);
  }
  @media (max-width: 48rem) {
    .about-company__grid,
    .about-company dl div {
      grid-template-columns: 1fr;
    }
  }
</style>
