---
import { claimBoundaries } from "../../../content/pages/about";
---

<section
  class="about-boundaries section"
  aria-labelledby="about-boundaries-title"
>
  <div class="container about-boundaries__grid">
    <header>
      <p>Trust boundaries</p>
      <h2 id="about-boundaries-title">Trust needs clear limits.</h2>
      <p>
        Pathwisse can stand for a clearer employability journey without turning
        uncertainty into a promise.
      </p>
    </header>
    <ul>
      {claimBoundaries.map((claim) => (
        <li>We will not claim that {claim}.</li>
      ))}
    </ul>
  </div>
</section>

<style>
  .about-boundaries__grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(3rem, 9vw, 9rem);
  }
  .about-boundaries header > p:first-child {
    color: var(--color-primary);
    font-size: var(--text-small);
    font-weight: var(--font-weight-semibold);
  }
  .about-boundaries header > p:last-child {
    color: var(--color-text-muted);
    font-size: var(--text-body-lg);
  }
  .about-boundaries ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .about-boundaries li {
    padding-block: var(--space-5);
    border-top: 1px solid var(--color-border);
    color: var(--color-text-muted);
  }
  @media (max-width: 48rem) {
    .about-boundaries__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
