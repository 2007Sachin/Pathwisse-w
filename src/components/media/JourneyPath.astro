---
interface Props {
  stages: readonly string[];
  dark?: boolean;
  compact?: boolean;
  label: string;
  motion?: "none" | "reveal";
}

const {
  stages,
  dark = false,
  compact = false,
  label,
  motion = "none",
} = Astro.props;
---

<ol
  class:list={[
    "journey-path",
    { "journey-path--dark": dark, "journey-path--compact": compact },
  ]}
  aria-label={label}
  data-motion={motion === "reveal" ? "journey" : undefined}
>
  {stages.map((stage, index) => (
    <li
      class:list={{ "journey-path__destination": index === stages.length - 1 }}
      style={`--stage-index: ${index}`}
    >
      <span class="journey-path__node" aria-hidden="true"></span>
      <span class="journey-path__number" aria-hidden="true">
        {String(index + 1).padStart(2, "0")}
      </span>
      <strong>{stage}</strong>
    </li>
  ))}
</ol>

<style>
  .journey-path {
    --path-line: var(--color-primary);
    --path-copy: var(--color-ink);
    position: relative;
    display: grid;
    grid-template-columns: repeat(var(--path-count, 6), minmax(0, 1fr));
    margin: 0;
    padding: 0;
    color: var(--path-copy);
    list-style: none;
  }
  .journey-path::before {
    position: absolute;
    top: 0.56rem;
    right: 0.6rem;
    left: 0.6rem;
    height: 1px;
    background: linear-gradient(
      90deg,
      var(--path-line) 0 88%,
      var(--color-accent) 100%
    );
    content: "";
    transform-origin: left;
  }
  .journey-path li {
    position: relative;
    display: grid;
    gap: var(--space-3);
    min-width: 0;
    padding: var(--space-8) var(--space-4) 0 0;
  }
  .journey-path__node {
    position: absolute;
    top: 0;
    left: 0;
    width: 1.125rem;
    height: 1.125rem;
    border: 3px solid var(--path-line);
    border-radius: 50%;
    background: var(--color-bg);
    transition:
      border-color var(--motion-fast) var(--ease-standard),
      transform var(--motion-standard) var(--ease-emphasis);
  }
  :global(.motion-enhanced) .journey-path[data-motion="journey"]::before {
    transform: scaleX(0);
  }
  :global(.motion-enhanced)
    .journey-path[data-motion="journey"].is-motion-visible::before {
    transform: scaleX(1);
    transition: transform var(--motion-story) var(--ease-emphasis);
  }
  :global(.motion-enhanced)
    .journey-path[data-motion="journey"]
    .journey-path__node {
    transform: scale(0.72);
  }
  :global(.motion-enhanced)
    .journey-path[data-motion="journey"].is-motion-visible
    .journey-path__node {
    transform: scale(1);
    transition-delay: calc(var(--stage-index, 0) * 90ms);
  }
  .journey-path__number {
    color: var(--color-text-muted);
    font-size: var(--text-caption);
  }
  .journey-path strong {
    max-width: 11ch;
    font-size: var(--text-small);
    font-weight: var(--font-weight-semibold);
    line-height: 1.3;
  }
  .journey-path__destination .journey-path__node {
    border-color: var(--color-accent);
  }
  .journey-path__destination strong {
    color: var(--path-copy);
  }
  .journey-path--dark {
    --path-copy: var(--color-text-on-dark);
  }
  .journey-path--dark .journey-path__node {
    background: var(--color-ink);
  }
  .journey-path--dark .journey-path__number {
    color: var(--color-text-muted-on-dark);
  }
  .journey-path--compact {
    --path-count: 4;
  }
  @media (max-width: 48rem) {
    .journey-path,
    .journey-path--compact {
      grid-template-columns: 1fr;
      gap: 0;
      padding-left: var(--space-8);
    }
    .journey-path::before {
      top: 0.6rem;
      bottom: 0.6rem;
      left: 0.52rem;
      width: 1px;
      height: auto;
      background: linear-gradient(
        180deg,
        var(--path-line) 0 88%,
        var(--color-accent) 100%
      );
      transform-origin: top;
    }
    .journey-path li {
      grid-template-columns: 2.25rem 1fr;
      gap: var(--space-3);
      min-height: 4.75rem;
      padding: 0 0 var(--space-6);
    }
    .journey-path__node {
      top: 0;
      left: calc(-1 * var(--space-8));
    }
    .journey-path strong {
      max-width: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .journey-path::before,
    .journey-path__node {
      transition: none !important;
      transform: none !important;
    }
  }
</style>
