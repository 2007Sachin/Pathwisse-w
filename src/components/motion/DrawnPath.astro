---
interface Props {
  orientation?: "vertical" | "horizontal";
  class?: string;
}
const { orientation = "vertical", class: className = "" } = Astro.props;
---

<svg
  class:list={["drawn-path", `drawn-path--${orientation}`, className]}
  viewBox={orientation === "vertical" ? "0 0 2 160" : "0 0 160 2"}
  aria-hidden="true"
  focusable="false"
>
  <path d={orientation === "vertical" ? "M1 1V159" : "M1 1H159"} />
</svg>
<style>
  .drawn-path {
    display: block;
    overflow: visible;
    color: var(--color-primary);
  }
  .drawn-path path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.25;
    stroke-linecap: round;
    stroke-dasharray: 158;
    stroke-dashoffset: calc(158 * (1 - var(--p, 0)));
    transition: stroke-dashoffset var(--motion-story) var(--ease-emphasis);
  }
  .drawn-path--vertical {
    width: 2px;
    height: 100%;
  }
  .drawn-path--horizontal {
    width: 100%;
    height: 2px;
  }
  @media (prefers-reduced-motion: reduce) {
    .drawn-path path {
      stroke-dashoffset: 0;
      transition: none;
    }
  }
</style>
